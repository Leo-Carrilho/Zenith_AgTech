const __vite__css = "/* ==========================================================\n   LOGIN.CSS  —  Zenith Agro  |  React + Vite\n   REFATORAÇÃO PREMIUM 2026\n   Direção visual: Agro-Tech Luxury — glassmorphism suave,\n   iluminação cinematográfica, microinterações refinadas.\n   ========================================================== */\n\n/*\n  NOTA: Carregar no index.html:\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link rel=\"stylesheet\"\n    href=\"https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&family=Playfair+Display:wght@700;800&display=swap\">\n*/\n\n\n/* =========================\n   DESIGN TOKENS — DARK THEME\n========================= */\n:root {\n  /* ─── Cores base ─── */\n  --color-forest-deep:      #091c13;\n  --color-forest-dark:      #0d2b1f;\n  --color-forest-mid:       #163626;\n  --color-forest-accent:    #1e5c30;\n  --color-forest-bright:    #2a7a42;\n  --color-leaf:             #3da65a;\n  --color-gold:             #f5e642;\n  --color-gold-warm:        #f0d840;\n\n  /* ─── Superfícies ─── */\n  --surface-page:           #091c13;\n  --surface-card:           rgba(248, 252, 246, 0.98);\n  --surface-card-glass:     rgba(255, 255, 255, 0.08);\n  --surface-input:          rgba(232, 244, 232, 0.55);\n  --surface-input-focus:    rgba(255, 255, 255, 0.90);\n\n  /* ─── Texto ─── */\n  --text-on-dark:           #ffffff;\n  --text-on-dark-dim:       rgba(255, 255, 255, 0.72);\n  --text-on-dark-faint:     rgba(255, 255, 255, 0.45);\n  --text-label:             #1a2f1e;\n  --text-body:              #2c4030;\n  --text-input:             #111f14;\n  --text-placeholder:       #8fa890;\n  --text-secondary:         #4e6a55;\n  --text-link:              #1a5c2a;\n  --text-link-hover:        #0e3d1c;\n\n  /* ─── Hero overlay ─── */\n  --hero-overlay-start:     rgba(6, 20, 10, 0.72);\n  --hero-overlay-end:       rgba(9, 28, 19, 0.30);\n\n  /* ─── Input ─── */\n  --input-border:           rgba(180, 210, 180, 0.50);\n  --input-border-focus:     #2a7a42;\n  --input-glow-focus:       rgba(42, 122, 66, 0.18);\n\n  /* ─── Botão primário ─── */\n  --btn-primary-bg:         linear-gradient(135deg, #1e5c30 0%, #2a7a42 50%, #1e5c30 100%);\n  --btn-primary-bg-hover:   linear-gradient(135deg, #163d22 0%, #1e5c30 50%, #163d22 100%);\n  --btn-primary-shadow:     0 8px 32px rgba(30, 92, 48, 0.45),\n                             0 2px 8px  rgba(30, 92, 48, 0.25);\n  --btn-primary-shadow-hover: 0 12px 40px rgba(30, 92, 48, 0.55),\n                               0 4px 12px  rgba(30, 92, 48, 0.30);\n  --btn-primary-text:       #ffffff;\n\n  /* ─── Botão social ─── */\n  --btn-social-bg:          rgba(255, 255, 255, 0.96);\n  --btn-social-border:      rgba(200, 220, 200, 0.70);\n  --btn-social-hover-bg:    rgba(240, 248, 240, 1);\n  --btn-social-shadow:      0 2px 12px rgba(0, 0, 0, 0.06),\n                             0 1px 3px  rgba(0, 0, 0, 0.04);\n\n  /* ─── Checkbox ─── */\n  --checkbox-border:        rgba(160, 195, 160, 0.70);\n  --checkbox-checked-bg:    #1e5c30;\n\n  /* ─── Alerts ─── */\n  --alert-error-bg:         rgba(255, 235, 235, 0.90);\n  --alert-error-text:       #b52b2b;\n  --alert-error-border:     rgba(220, 150, 150, 0.60);\n  --alert-success-bg:       rgba(230, 255, 238, 0.90);\n  --alert-success-text:     #166633;\n  --alert-success-border:   rgba(140, 210, 160, 0.60);\n\n  /* ─── Card ─── */\n  --card-shadow:            0 -16px 60px rgba(0, 0, 0, 0.22),\n                             0 -4px  20px rgba(0, 0, 0, 0.10);\n  --card-shadow-desktop:    0 24px 80px rgba(0, 0, 0, 0.35),\n                             0  8px 24px rgba(0, 0, 0, 0.18);\n\n  /* ─── Divisor ─── */\n  --divider-line:           rgba(180, 210, 180, 0.45);\n  --divider-text:           #8fa890;\n\n  /* ─── Círculos deco ─── */\n  --deco-color:             #1a4d2b;\n\n  /* ─── Tipografia ─── */\n  --font-body:              'DM Sans', 'Helvetica Neue', Arial, sans-serif;\n  --font-display:           'Playfair Display', Georgia, serif;\n\n  /* ─── Animações ─── */\n  --ease-out-quart:         cubic-bezier(0.25, 1, 0.5, 1);\n  --ease-in-out-quart:      cubic-bezier(0.76, 0, 0.24, 1);\n  --ease-spring:            cubic-bezier(0.34, 1.56, 0.64, 1);\n  --duration-fast:          180ms;\n  --duration-base:          260ms;\n  --duration-slow:          420ms;\n\n  /* ─── Bordas ─── */\n  --radius-card-mobile:     28px 28px 0 0;\n  --radius-card-desktop:    24px;\n  --radius-input:           14px;\n  --radius-btn-primary:     50px;\n  --radius-btn-social:      14px;\n}\n\n\n/* ─── Light theme override ─── */\n@media (prefers-color-scheme: light) {\n  :root {\n    --surface-page:           #ddeedd;\n    --surface-card:           rgba(255, 255, 255, 0.99);\n    --surface-input:          rgba(225, 242, 228, 0.65);\n    --text-label:             #142218;\n    --text-body:              #283c2c;\n    --text-secondary:         #3e5a44;\n    --text-link:              #145520;\n    --input-border:           rgba(160, 200, 160, 0.60);\n    --card-shadow:            0 -12px 50px rgba(0, 0, 0, 0.14);\n    --deco-color:             #2a6640;\n  }\n}\n\n\n/* =========================\n   RESET / BASE\n========================= */\n*, *::before, *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: var(--font-body);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  background: var(--surface-page);\n}\n\nbutton {\n  cursor: pointer;\n  border: none;\n  background: none;\n  font-family: inherit;\n}\n\na { text-decoration: none; }\ninput { font-family: inherit; }\n\n\n/* =========================\n   PAGE LAYOUT\n========================= */\n.login-page {\n  position: relative;\n  min-height: 100dvh;\n  display: flex;\n  flex-direction: column;\n  background: var(--surface-page);\n  overflow-x: hidden;\n  padding: 0;\n}\n\n\n/* =========================\n   HERO PANEL\n========================= */\n.login-hero {\n  position: relative;\n  flex: 0 0 auto;\n  /* Força 100vw e cancela qualquer offset de pai com padding/margin */\n  width: 100vw;\n  margin-left: calc(50% - 50vw);\n  height: 54vw;\n  min-height: 240px;\n  max-height: 360px;\n  /* Imagem local com fallback Unsplash (campo/fazenda) */\n  background-image:\n    url(\"assets/image/img-fundoLogineCadastro.jpg\"),\n    url(\"https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=900&q=80\");\n  background-size: cover;\n  background-position: center 40%;\n  background-repeat: no-repeat;\n  display: flex;\n  align-items: flex-end;\n}\n\n/* Overlay cinematográfico em duas camadas */\n.login-hero__overlay {\n  position: absolute;\n  inset: 0;\n  background:\n    linear-gradient(\n      180deg,\n      rgba(6, 20, 10, 0.45) 0%,\n      rgba(9, 28, 19, 0.20) 45%,\n      rgba(9, 28, 19, 0.55) 80%,\n      rgba(6, 18, 10, 0.82) 100%\n    );\n}\n\n/* Vinheta lateral sutil */\n.login-hero__overlay::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(\n    ellipse 130% 100% at 50% 0%,\n    transparent 35%,\n    rgba(6, 18, 10, 0.45) 100%\n  );\n}\n\n.login-hero__content {\n  position: relative;\n  z-index: 1;\n  padding: 0 26px 28px;\n  width: 100%;\n  animation: heroContentIn var(--duration-slow) var(--ease-out-quart) both;\n}\n\n@keyframes heroContentIn {\n  from { opacity: 0; transform: translateY(16px); }\n  to   { opacity: 1; transform: translateY(0);    }\n}\n\n.login-hero__subtitle {\n   font-family: \"Poppins\", sans-serif;\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-on-dark);\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  margin-bottom: 6px;\n}\n\n.login-hero__title {\n  font-family: \"Poppins\", sans-serif;\n  font-size: clamp(46px, 14vw, 72px);\n  font-weight: 500;\n  color: var(--text-on-dark);\n  letter-spacing: -0.02em;\n  line-height: 1;\n  /* Glow de texto extremamente suave */\n  text-shadow:\n    0 0 60px rgba(42, 122, 66, 0.45),\n    0 2px 20px rgba(0, 0, 0, 0.35);\n}\n\n\n/* =========================\n   LOGO\n========================= */\n.login-logo {\n  margin-bottom: 22px;\n  display: inline-block;\n}\n\n.logo-img {\n  width: 68px;\n  height: 68px;\n  border-radius: 50%;\n  box-shadow:\n    0 4px 20px rgba(0, 0, 0, 0.35),\n    0 0 0 3px rgba(255, 255, 255, 0.15);\n  object-fit: cover;\n}\n\n\n/* =========================\n   CARD — formulário\n========================= */\n.login-card {\n  position: relative;\n  z-index: 2;\n  flex: 1;\n  background: var(--surface-card);\n  border-radius: var(--radius-card-mobile);\n  box-shadow: var(--card-shadow);\n  padding: 38px 28px 44px;\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n\n  /* Entrada suave do card */\n  animation: cardSlideUp var(--duration-slow) var(--ease-out-quart) 0.08s both;\n}\n\n@keyframes cardSlideUp {\n  from { opacity: 0; transform: translateY(28px); }\n  to   { opacity: 1; transform: translateY(0);    }\n}\n\n\n/* =========================\n   FORM FIELDS\n========================= */\n.login__field {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  position: relative;\n}\n\n.login__label {\n  font-size: 11.5px;\n  font-weight: 700;\n  color: var(--text-label);\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.login__input-wrapper {\n  position: relative;\n  display: flex;\n  align-items: center;\n}\n\n.login__input {\n  width: 100%;\n  background: var(--surface-input);\n  border: 1.5px solid var(--input-border);\n  border-radius: var(--radius-input);\n  padding: 13px 42px 13px 16px;\n  font-size: 15px;\n  font-weight: 400;\n  color: var(--text-input);\n  letter-spacing: 0.01em;\n  outline: none;\n  transition:\n    background  var(--duration-base) var(--ease-out-quart),\n    border-color var(--duration-base) var(--ease-out-quart),\n    box-shadow   var(--duration-base) var(--ease-out-quart);\n  -webkit-appearance: none;\n}\n\n.login__input:focus {\n  background: var(--surface-input-focus);\n  border-color: var(--input-border-focus);\n  box-shadow:\n    0 0 0 4px var(--input-glow-focus),\n    0 2px 12px rgba(42, 122, 66, 0.12);\n}\n\n.login__input:focus-visible {\n  outline: 2px solid var(--input-border-focus);\n  outline-offset: 3px;\n  border-radius: var(--radius-input);\n}\n\n.login__input::placeholder {\n  color: var(--text-placeholder);\n  font-size: 14px;\n  font-weight: 400;\n}\n\n.login__input:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* Linha de underline legado — removida */\n.login__input-line { display: none; }\n\n/* Eye toggle */\n.login__eye-btn {\n  position: absolute;\n  right: 14px;\n  top: 50%;\n  transform: translateY(-50%);\n  color: var(--text-placeholder);\n  display: flex;\n  align-items: center;\n  padding: 4px;\n  border-radius: 8px;\n  transition:\n    color  var(--duration-fast) ease,\n    opacity var(--duration-fast) ease;\n  background: none;\n}\n\n.login__eye-btn:hover {\n  color: var(--text-body);\n}\n\n.login__eye-btn:focus-visible {\n  outline: 2px solid var(--input-border-focus);\n  outline-offset: 2px;\n}\n\n\n/* =========================\n   EXTRAS — Remember + Forgot\n========================= */\n.login-extras {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: -2px;\n}\n\n.login-remember {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  cursor: pointer;\n  user-select: none;\n}\n\n.login-remember__input {\n  position: absolute;\n  opacity: 0;\n  width: 0;\n  height: 0;\n}\n\n.login-remember__box {\n  width: 18px;\n  height: 18px;\n  border-radius: 6px;\n  border: 1.5px solid var(--checkbox-border);\n  background: var(--surface-input);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  transition:\n    background     var(--duration-fast) ease,\n    border-color   var(--duration-fast) ease,\n    box-shadow     var(--duration-fast) ease;\n  position: relative;\n}\n\n.login-remember__input:checked + .login-remember__box {\n  background: var(--checkbox-checked-bg);\n  border-color: var(--checkbox-checked-bg);\n  box-shadow: 0 2px 8px rgba(30, 92, 48, 0.35);\n}\n\n.login-remember__input:checked + .login-remember__box::after {\n  content: '';\n  position: absolute;\n  width: 5px;\n  height: 9px;\n  border: 2px solid #fff;\n  border-top: none;\n  border-left: none;\n  transform: rotate(44deg) translate(-1px, -1px);\n}\n\n.login-remember__input:focus-visible + .login-remember__box {\n  outline: 2px solid var(--input-border-focus);\n  outline-offset: 2px;\n}\n\n.login-remember__text {\n  font-size: 13px;\n  color: var(--text-secondary);\n  font-weight: 500;\n}\n\n.login-forgot {\n  font-size: 13px;\n  color: var(--text-link);\n  font-weight: 600;\n  letter-spacing: 0.01em;\n  border-radius: 4px;\n  transition: color var(--duration-fast) ease, opacity var(--duration-fast) ease;\n}\n\n.login-forgot:hover { opacity: 0.7; }\n\n.login-forgot:focus-visible,\n.login-register__link:focus-visible {\n  outline: 2px solid var(--input-border-focus);\n  outline-offset: 3px;\n  border-radius: 4px;\n}\n\n\n/* =========================\n   ALERT MESSAGE\n========================= */\n.login__alert {\n  font-size: 13px;\n  font-weight: 500;\n  padding: 12px 16px;\n  border-radius: 12px;\n  border: 1px solid transparent;\n  line-height: 1.5;\n  backdrop-filter: blur(4px);\n  -webkit-backdrop-filter: blur(4px);\n  animation: alertIn var(--duration-base) var(--ease-out-quart) both;\n}\n\n@keyframes alertIn {\n  from { opacity: 0; transform: translateY(-6px) scale(0.98); }\n  to   { opacity: 1; transform: translateY(0)    scale(1);    }\n}\n\n.login__alert--error {\n  background: var(--alert-error-bg);\n  color: var(--alert-error-text);\n  border-color: var(--alert-error-border);\n}\n\n.login__alert--success {\n  background: var(--alert-success-bg);\n  color: var(--alert-success-text);\n  border-color: var(--alert-success-border);\n}\n\n\n/* =========================\n   PRIMARY BUTTON\n========================= */\n.login__btn-primary {\n  width: 100%;\n  height: 54px;\n  background: var(--btn-primary-bg);\n  background-size: 200% 100%;\n  background-position: 100% 0;\n  color: var(--btn-primary-text);\n  font-size: 15px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  border-radius: var(--radius-btn-primary);\n  border: none;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  position: relative;\n  overflow: hidden;\n\n  transition:\n    background-position var(--duration-slow) var(--ease-in-out-quart),\n    box-shadow           var(--duration-base) var(--ease-out-quart),\n    transform            var(--duration-fast) var(--ease-out-quart);\n  box-shadow: var(--btn-primary-shadow);\n  will-change: transform;\n}\n\n/* Shimmer overlay no hover */\n.login__btn-primary::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    105deg,\n    transparent 30%,\n    rgba(255, 255, 255, 0.10) 50%,\n    transparent 70%\n  );\n  transform: translateX(-100%);\n  transition: transform 0.55s var(--ease-in-out-quart);\n}\n\n.login__btn-primary:hover:not(:disabled) {\n  background-position: 0 0;\n  box-shadow: var(--btn-primary-shadow-hover);\n  transform: translateY(-2px);\n}\n\n.login__btn-primary:hover:not(:disabled)::before {\n  transform: translateX(100%);\n}\n\n.login__btn-primary:active:not(:disabled) {\n  transform: translateY(0) scale(0.985);\n  box-shadow: 0 4px 16px rgba(30, 92, 48, 0.35);\n}\n\n.login__btn-primary:disabled {\n  opacity: 0.65;\n  cursor: not-allowed;\n}\n\n.login__btn-primary--loading {\n  pointer-events: none;\n}\n\n.login__btn-primary:focus-visible {\n  outline: 3px solid rgba(42, 122, 66, 0.70);\n  outline-offset: 3px;\n}\n\n.login__btn-loading-text {\n  font-size: 15px;\n  font-weight: 700;\n}\n\n/* Spinner */\n.login__spinner {\n  display: inline-block;\n  width: 18px;\n  height: 18px;\n  border: 2px solid rgba(255, 255, 255, 0.30);\n  border-top-color: #fff;\n  border-radius: 50%;\n  animation: loginSpin 0.65s linear infinite;\n  will-change: transform;\n  flex-shrink: 0;\n}\n\n@keyframes loginSpin {\n  to { transform: rotate(360deg); }\n}\n\n\n/* =========================\n   DIVIDER\n========================= */\n.login-divider {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin: 2px 0;\n}\n\n.login-divider__line {\n  flex: 1;\n  height: 1px;\n  background: var(--divider-line);\n}\n\n.login-divider__text {\n  font-size: 12px;\n  color: var(--divider-text);\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n\n/* =========================\n   REGISTER LINK\n========================= */\n.login-register {\n  text-align: center;\n  font-size: 14px;\n  color: var(--text-secondary);\n  font-weight: 400;\n}\n\n.login-register__link {\n  color: var(--text-link);\n  font-weight: 700;\n  border-radius: 4px;\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  text-decoration-thickness: 1.5px;\n  transition: color var(--duration-fast) ease, opacity var(--duration-fast) ease;\n}\n\n.login-register__link:hover { opacity: 0.70; }\n\n\n/* =========================\n   SOCIAL BUTTONS\n========================= */\n.login-social {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  margin-top: 2px;\n}\n\n.login__btn-social {\n  width: 100%;\n  height: 50px;\n  background: var(--btn-social-bg);\n  border: 1.5px solid var(--btn-social-border);\n  border-radius: var(--radius-btn-social);\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 14px;\n  padding: 0 20px;\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--text-body);\n  box-shadow: var(--btn-social-shadow);\n  transition:\n    background   var(--duration-base) var(--ease-out-quart),\n    box-shadow   var(--duration-base) var(--ease-out-quart),\n    transform    var(--duration-fast) var(--ease-out-quart),\n    border-color var(--duration-base) var(--ease-out-quart);\n}\n\n.login__btn-social:hover {\n  background: var(--btn-social-hover-bg);\n  box-shadow:\n    0 4px 20px rgba(0, 0, 0, 0.10),\n    0 1px 4px  rgba(0, 0, 0, 0.06);\n  border-color: rgba(160, 200, 160, 0.90);\n  transform: translateY(-1px);\n}\n\n.login__btn-social:active { transform: translateY(0); }\n\n.login__btn-social:focus-visible {\n  outline: 2px solid var(--input-border-focus);\n  outline-offset: 2px;\n}\n\n.login__btn-social-icon {\n  display: flex;\n  align-items: center;\n  flex-shrink: 0;\n}\n\n.login__btn-social-label {\n  flex: 1;\n  text-align: center;\n  margin-right: 20px;\n}\n\n\n/* =========================\n   DECORATIVE CIRCLES\n========================= */\n.login-deco-circle {\n  display: none;\n}\n\n.login-deco-circle--br {\n  bottom: -44px;\n  right: -44px;\n  animation: floatCircle 7s ease-in-out infinite alternate;\n}\n\n.login-deco-circle--bl {\n  bottom: -64px;\n  left: -54px;\n  width: 108px;\n  height: 108px;\n  opacity: 0.55;\n  animation: floatCircle 9s ease-in-out 1s infinite alternate;\n}\n\n@keyframes floatCircle {\n  from { transform: translate(0, 0); }\n  to   { transform: translate(8px, -8px); }\n}\n\n\n/* =========================\n   STAGGERED FIELD ANIMATIONS\n========================= */\n.login__field:nth-child(1) { animation: fieldIn var(--duration-slow) var(--ease-out-quart) 0.18s both; }\n.login__field:nth-child(2) { animation: fieldIn var(--duration-slow) var(--ease-out-quart) 0.26s both; }\n\n@keyframes fieldIn {\n  from { opacity: 0; transform: translateY(14px); }\n  to   { opacity: 1; transform: translateY(0);    }\n}\n\n.login-extras  { animation: fieldIn var(--duration-slow) var(--ease-out-quart) 0.32s both; }\n.login__btn-primary { animation: fieldIn var(--duration-slow) var(--ease-out-quart) 0.38s both; }\n.login-divider { animation: fieldIn var(--duration-slow) var(--ease-out-quart) 0.44s both; }\n.login-register { animation: fieldIn var(--duration-slow) var(--ease-out-quart) 0.48s both; }\n.login-social  { animation: fieldIn var(--duration-slow) var(--ease-out-quart) 0.54s both; }\n\n\n/* =========================\n   RESPONSIVE — TABLET (≥ 640px)\n========================= */\n@media (min-width: 640px) {\n  .login-page {\n    align-items: center;\n    justify-content: center;\n    background: var(--color-forest-deep);\n    padding: 40px 20px;\n  }\n\n  .login-hero { display: none; }\n\n  /* Imagem de fundo blur-escurecida */\n  .login-page::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background-image: url('https://images.unsplash.com/photo-1523348837708-15d4a09cfac2?w=1400&q=80');\n    background-size: cover;\n    background-position: center;\n    filter: brightness(0.25) saturate(0.8);\n    z-index: 0;\n    will-change: transform;\n  }\n\n  /* Vinheta sobre a imagem */\n  .login-page::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(\n      ellipse 80% 80% at 50% 50%,\n      transparent 30%,\n      rgba(6, 18, 10, 0.60) 100%\n    );\n    z-index: 0;\n    pointer-events: none;\n  }\n\n  .login-card {\n    position: relative;\n    z-index: 2;\n    width: 100%;\n    max-width: 430px;\n    border-radius: var(--radius-card-desktop);\n    box-shadow: var(--card-shadow-desktop);\n    flex: 0 0 auto;\n    padding: 40px 36px 48px;\n    /* Glassmorphism suave no desktop */\n    background: rgba(250, 253, 248, 0.97);\n    backdrop-filter: blur(24px);\n    -webkit-backdrop-filter: blur(24px);\n    border: 1px solid rgba(255, 255, 255, 0.22);\n  }\n\n  .login-deco-circle { display: none; }\n}\n\n\n/* =========================\n   RESPONSIVE — DESKTOP (≥ 1024px)\n========================= */\n@media (min-width: 1024px) {\n  .login-page {\n    display: grid;\n    grid-template-columns: 1.1fr 0.9fr;\n    min-height: 100dvh;\n    padding: 0;\n    background: var