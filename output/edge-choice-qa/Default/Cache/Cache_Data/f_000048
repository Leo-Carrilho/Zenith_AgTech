\n\n.field-base {\n  stroke: rgba(255, 255, 255, 0.88);\n  stroke-width: 7;\n  stroke-linejoin: round;\n}\n\n.field-texture {\n  opacity: 0.54;\n}\n\n.field-border {\n  fill: transparent;\n  stroke: rgba(255, 255, 255, 0.92);\n  stroke-width: 4;\n  stroke-linejoin: round;\n}\n\n.water-channel {\n  fill: none;\n  stroke: rgba(57, 183, 225, 0.78);\n  stroke-width: 38;\n  stroke-linecap: round;\n}\n\n.field-road {\n  fill: none;\n  stroke: rgba(255, 255, 255, 0.76);\n  stroke-width: 16;\n  stroke-linecap: round;\n}\n\n.zone {\n  opacity: 0.42;\n  stroke: rgba(255, 255, 255, 0.8);\n  stroke-width: 3;\n}\n\n.zone-map {\n  stroke: rgba(255, 255, 255, 0.88);\n  stroke-width: 4;\n  stroke-linejoin: round;\n  filter: drop-shadow(0 3px 5px rgba(20, 43, 27, 0.18));\n}\n\n.zone-blue {\n  fill: #36a9e1;\n}\n\n.zone-light {\n  fill: #d7f5c4;\n}\n\n.zone-warning {\n  fill: #f6cf65;\n}\n\n.field-marker {\n  stroke: #fff;\n  stroke-width: 1.5;\n  filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.24));\n}\n\n.field-marker.warning {\n  fill: #ffc247;\n}\n\n.field-marker.critical {\n  fill: #f04438;\n}\n\n.site-pin circle:first-child {\n  fill: #38d481;\n  stroke: #fff;\n  stroke-width: 5;\n}\n\n.site-pin circle:last-child {\n  fill: #fff;\n  opacity: 0.82;\n}\n\n.farm3d-label {\n  position: absolute;\n  padding: 8px 10px;\n  border-radius: 10px;\n  background: #fff;\n  color: rgba(32, 57, 42, 0.78);\n  font-size: 11px;\n  font-weight: 700;\n  line-height: 1.2;\n  box-shadow: 0 10px 22px rgba(32, 57, 42, 0.16);\n  transform: translateZ(22px);\n  pointer-events: none;\n}\n\n.farm3d-label strong {\n  color: var(--g1);\n}\n\n.zone-label {\n  border: 2px solid var(--g4);\n  transform: translate(-50%, -50%) translateZ(28px);\n}\n\n.zone-label strong {\n  display: block;\n  max-width: 86px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.site-a {\n  left: 52%;\n  top: 41%;\n}\n\n.site-b {\n  left: 29%;\n  top: 34%;\n}\n\n.site-c {\n  right: 21%;\n  bottom: 28%;\n}\n\n.farm3d-controls {\n  position: absolute;\n  right: 12px;\n  bottom: 12px;\n  display: flex;\n  gap: 8px;\n  padding: 6px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.82);\n  border: 1px solid rgba(45, 97, 64, 0.12);\n  box-shadow: 0 12px 26px rgba(32, 57, 42, 0.15);\n}\n\n.farm3d-controls button {\n  width: 38px;\n  height: 38px;\n  min-height: 38px;\n  border: none;\n  border-radius: 50%;\n  background: var(--g4);\n  color: #fff;\n  font-size: 18px;\n  font-weight: 800;\n  line-height: 1;\n  cursor: pointer;\n}\n\n.farm3d-controls button:hover {\n  background: var(--g5);\n}\n\n.farm3d-metric {\n  position: relative;\n  min-height: 82px;\n  display: grid;\n  grid-template-columns: 42px 1fr 94px;\n  gap: 10px;\n  align-items: center;\n  padding: 12px;\n}\n\n.metric-icon {\n  width: 34px;\n  height: 34px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  background: #38d481;\n  color: #fff;\n  font-size: 18px;\n}\n\n.farm3d-metric.warning .metric-icon {\n  background: #ffb93f;\n}\n\n.farm3d-metric.danger .metric-icon {\n  background: #ff3f34;\n}\n\n.farm3d-metric span {\n  display: block;\n  color: rgba(32, 57, 42, 0.68);\n  font-size: 12px;\n  margin-bottom: 4px;\n}\n\n.farm3d-metric strong {\n  color: var(--g1);\n  font-size: 20px;\n  line-height: 1;\n}\n\n.metric-sparkline {\n  width: 86px;\n  height: 42px;\n}\n\n.metric-sparkline path:first-child {\n  stroke: rgba(45, 97, 64, 0.12);\n}\n\n.metric-sparkline path {\n  fill: none;\n  stroke: #39d98a;\n  stroke-width: 3;\n  stroke-linecap: round;\n}\n\n.farm3d-metric.warning .metric-sparkline path:last-child {\n  stroke: #ffb93f;\n}\n\n.farm3d-metric.danger .metric-sparkline path:last-child {\n  stroke: #ff4b3e;\n}\n\n.farm3d-actions {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  margin-top: 16px;\n  padding: 14px;\n  border-radius: 14px;\n  background: rgba(255, 255, 255, 0.76);\n  border: 1px solid rgba(45, 97, 64, 0.1);\n}\n\n.farm3d-actions strong {\n  display: block;\n  color: var(--g1);\n  font-size: 14px;\n  margin-bottom: 4px;\n}\n\n.farm3d-actions button {\n  min-height: 44px;\n  padding: 0 18px;\n  border: none;\n  border-radius: 12px;\n  background: var(--g4);\n  color: #fff;\n  font-weight: 800;\n  cursor: pointer;\n}\n\n.farm3d-actions button:hover {\n  background: var(--g5);\n  transform: translateY(-1px);\n}\n\n@media (max-width: 599px) {\n  .farm3d-panel {\n    padding: 16px;\n    border-radius: 18px;\n  }\n\n  .farm3d-scene {\n    min-height: 330px;\n    border-radius: 16px;\n  }\n\n  .farm3d-stage {\n    width: 98%;\n    filter: drop-shadow(0 20px 14px rgba(35, 54, 38, 0.2));\n  }\n\n  .farm3d-label {\n    font-size: 10px;\n    padding: 6px 8px;\n    border-radius: 9px;\n  }\n\n  .site-a {\n    left: 50%;\n    top: 42%;\n  }\n\n  .site-b {\n    left: 22%;\n    top: 30%;\n  }\n\n  .site-c {\n    right: 12%;\n    bottom: 24%;\n  }\n\n  .farm3d-controls {\n    right: 10px;\n    bottom: 10px;\n  }\n\n  .farm3d-controls button {\n    width: 34px;\n    height: 34px;\n    min-height: 34px;\n    font-size: 16px;\n  }\n\n  .farm3d-metric {\n    grid-template-columns: 40px 1fr;\n  }\n\n  .metric-sparkline {\n    display: none;\n  }\n}\n\n/* ================= CARDS ================= */\n.areas-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  margin-bottom: 20px;\n  padding: 0 4px;\n}\n\n.areas-header h3 {\n  font-size: 18px;\n  font-weight: 700;\n  color: var(--g1);\n  margin: 0;\n}\n\n.areas-count {\n  font-size: 13px;\n  color: var(--g1);\n  background: #f7f5f0;\n  box-shadow: 0 10px 30px var(--primary-glow);\n  padding: 6px 12px;\n  border-radius: 20px;\n  font-weight: 600;\n}\n\n.areas-cards {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 16px;\n  animation: fadeInUp 0.5s ease;\n}\n\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.area-card-modern {\n  background: #f7f5f0;\n  box-shadow: 0 10px 30px var(--primary-glow);\n  backdrop-filter: blur(10px);\n  border: 1px solid var(--glass-border);\n  border-radius: 20px;\n  padding: 18px;\n  cursor: pointer;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  position: relative;\n  overflow: hidden;\n}\n\n.area-card-modern::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: -100%;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);\n  transition: left 0.5s;\n}\n\n.area-card-modern:hover::before {\n  left: 100%;\n}\n\n.area-card-modern:hover {\n  transform: translateY(-4px) scale(1.02);\n  border-color: var(--primary);\n  box-shadow: 0 8px 20px rgba(86, 168, 112, 0.2);\n}\n\n.area-card-modern.selected {\n  border-color: var(--primary);\n  background: #f7f5f0;\n  box-shadow: 0 4px 16px rgba(86, 168, 112, 0.25);\n}\n\n/* HEADER DO CARD */\n.card-header {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-bottom: 16px;\n}\n\n.card-icon {\n  width: 48px;\n  height: 48px;\n  border-radius: 14px;\n  background: var(--primary-soft);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 24px;\n  transition: transform 0.2s ease;\n}\n\n.area-card-modern:hover .card-icon {\n  transform: scale(1.1) rotate(5deg);\n}\n\n.card-title {\n  flex: 1;\n}\n\n.card-title h4 {\n  margin: 0 0 4px 0;\n  font-size: 16px;\n  font-weight: 700;\n  color: var(--g1);\n}\n\n.card-date {\n  font-size: 11px;\n  color: var(--g1);\n  opacity: 0.7;\n}\n\n/* STATS */\n.card-stats {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  background: #f7f5f0;\n  box-shadow: 0 10px 30px var(--primary-glow);\n  padding: 14px;\n  border-radius: 14px;\n  margin-bottom: 16px;\n  transition: all 0.2s ease;\n}\n\n.stat {\n  text-align: center;\n  flex: 1;\n}\n\n.stat-label {\n  font-size: 11px;\n  color: var(--g1);\n  opacity: 0.75;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  margin-bottom: 6px;\n  display: block;\n}\n\n.stat-value {\n  font-size: 16px;\n  font-weight: 800;\n  color: var(--g1);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n}\n\n.status-dot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  display: inline-block;\n  animation: pulse 2s infinite;\n}\n\n@keyframes pulse {\n  0%, 100% {\n    opacity: 1;\n    transform: scale(1);\n  }\n  50% {\n    opacity: 0.7;\n    transform: scale(1.2);\n  }\n}\n\n/* BOTÕES DO CARD */\n.card-footer-actions {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.view-btn,\n.delete-btn-modern {\n  width: 100%;\n  height: 44px;\n  border-radius: 12px;\n  border: none;\n  cursor: pointer;\n  font-weight: 600;\n  font-size: 14px;\n  transition: all 0.2s ease;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n}\n\n.view-btn {\n  background: var(--g4);\n  color: #fff;\n  border: 1px solid var(--g4);\n  box-shadow: 0 10px 30px var(--primary-glow);\n}\n\n.view-btn:hover {\n  background: var(--g5);\n  border-color: var(--g5);\n  color: #fff;\n  transform: translateY(-2px);\n}\n\n.delete-btn-modern {\n  background: rgba(220, 53, 69, 0.1);\n  color: var(--danger);\n  border: 1px solid rgba(220, 53, 69, 0.2);\n}\n\n.delete-btn-modern:hover {\n  background: rgba(220, 53, 69, 0.2);\n  border-color: var(--danger);\n  transform: translateY(-2px);\n}\n\n.show-more-areas-btn {\n  width: 100%;\n  min-height: 48px;\n  margin-top: 16px;\n  padding: 12px 16px;\n  border-radius: 14px;\n  border: 1px solid rgba(45, 97, 64, 0.32);\n  background: rgba(45, 97, 64, 0.12);\n  color: var(--g4);\n  font-size: 14px;\n  font-weight: 700;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  transition: all 0.2s ease;\n}\n\n.show-more-areas-btn span {\n  color: var(--g4);\n  font-size: 12px;\n  font-weight: 600;\n  opacity: 0.75;\n}\n\n.show-more-areas-btn:hover {\n  background: rgba(45, 97, 64, 0.18);\n  border-color: rgba(45, 97, 64, 0.45);\n  transform: translateY(-2px);\n}\n\n/* Empty State */\n.empty-areas {\n  text-align: center;\n  padding: 60px 20px;\n  background: #f7f5f0;\n  box-shadow: 0 10px 30px var(--primary-glow);\n  border-radius: 20px;\n  border: 2px dashed var(--glass-border);\n  animation: fadeIn 0.5s ease;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n.empty-icon {\n  font-size: 64px;\n  margin-bottom: 16px;\n  opacity: 0.5;\n  animation: float 3s ease-in-out infinite;\n}\n\n@keyframes float {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-10px); }\n}\n\n.empty-areas p {\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--g1);\n  margin-bottom: 8px;\n}\n\n.empty-areas span {\n  font-size: 13px;\n  color: var(--g1);\n  opacity: 0.7;\n}\n\n/* ================= MODAL ================= */\n.mapa-modal {\n  position: fixed;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.9);\n  backdrop-filter: blur(8px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  z-index: 1000;\n  animation: fadeIn 0.3s ease;\n}\n\n.area-detail-modal {\n  width: 100%;\n  max-width: 500px;\n  background: #f7f5f0;\n  box-shadow: 0 10px 30px var(--primary-glow);\n  border-radius: 24px;\n  padding: 24px;\n  position: relative;\n  animation: slideInUp 0.3s ease;\n  border: 1px solid var(--glass-border);\n}\n\n.close-btn {\n  position: absolute;\n  top: 16px;\n  right: 16px;\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  border: none;\n  background: #f7f5f0;\n  box-shadow: 0 10px 30px var(--primary-glow);\n  font-size: 20px;\n  cursor: pointer;\n  color: var(--text-muted);\n  transition: all 0.2s ease;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.close-btn:hover {\n  background: rgba(220, 53, 69, 0.2);\n  color: var(--danger);\n  transform: rotate(90deg);\n}\n\n.detail-header {\n  display: flex;\n