;\n}\n.text-secondary {\n  color: var(--text-secondary);\n  font-size: 1rem;\n}\n/* ===== RESULT CARD ===== */\n.result-card {\n  background: #f7f5f0;\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border: 1px solid var(--glass-border);\n  border-radius: 40px;\n  overflow: hidden;\n  box-shadow: var(--card-shadow);\n}\n.result-header {\n  position: relative;\n  height: 250px;\n}\n.result-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n.result-badge {\n  position: absolute;\n  top: 20px;\n  right: 20px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  background: #f7f5f0;\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  padding: 12px 20px;\n  border-radius: 40px;\n  border: 1px solid var(--glass-border);\n  color: var(--primary);\n  font-size: 0.9rem;\n  font-weight: 500;\n}\n.result-badge span {\n  font-size: 20px;\n}\n.result-content {\n  padding: 30px;\n}\n.disease-name {\n  font-size: 2rem;\n  margin-bottom: 24px;\n  color: var(--text-primary);\n  font-weight: 700;\n}\n.confidence-section {\n  margin-bottom: 24px;\n}\n.confidence-label {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 12px;\n  color: var(--text-secondary);\n  font-size: 0.9rem;\n}\n.confidence-value {\n  color: var(--primary);\n  font-weight: bold;\n  font-size: 1.2rem;\n}\n.progress-bar {\n  width: 100%;\n  height: 10px;\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 5px;\n  overflow: hidden;\n}\n.progress-fill {\n  height: 100%;\n  background: linear-gradient(90deg, var(--primary), var(--secondary));\n  border-radius: 5px;\n  transition: width 0.3s ease;\n}\n.severity-tag {\n  display: inline-flex;\n  align-items: center;\n  padding: 10px 20px;\n  border-radius: 40px;\n  border: 1px solid;\n  font-size: 0.9rem;\n  font-weight: 600;\n  margin-bottom: 24px;\n}\n.severity-tag.severity-baixa {\n  border-color: var(--g6);\n  color: var(--g6);\n}\n.severity-tag.severity-moderada {\n  border-color: #ffaa00;\n  color: #ffaa00;\n}\n.severity-tag.severity-alta {\n  border-color: #ff4444;\n  color: #ff4444;\n}\n.reanalysis-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 12px;\n  background: rgba(0, 102, 255, 0.1);\n  border: 1px solid rgba(0, 102, 255, 0.3);\n  border-radius: 30px;\n  color: #0066ff;\n  font-size: 11px;\n  margin-bottom: 16px;\n}\n.reanalysis-badge span {\n  font-size: 16px;\n}\n.info-section {\n  margin-bottom: 24px;\n  padding: 20px;\n  background: #f7f5f0;\n  border: 1px solid var(--glass-border);\n  border-radius: 24px;\n}\n.info-section h4 {\n  color: var(--primary);\n  margin-bottom: 12px;\n  font-size: 1rem;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.info-section p {\n  color: var(--text-secondary);\n  line-height: 1.6;\n  font-size: 0.95rem;\n}\n.result-actions {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n  margin-top: 30px;\n}\n.action-btn {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 16px;\n  border-radius: 40px;\n  border: none;\n  font-size: 1rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n.action-btn.primary {\n  background: linear-gradient(135deg, var(--primary), var(--secondary));\n  color: #000;\n}\n.action-btn.primary:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 10px 30px var(--primary-glow);\n}\n.action-btn.secondary {\n  background: #f7f5f0;\n  border: 1px solid var(--glass-border);\n  color: var(--text-primary);\n}\n.action-btn.secondary:hover {\n  border-color: var(--primary);\n  transform: translateY(-2px);\n}\n.action-btn span {\n  font-size: 20px;\n}\n/* ===== HISTÓRICO TAB ===== */\n.historico-container {\n  max-width: 600px;\n  margin: 0 auto;\n}\n.activities-list {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.activity-card {\n  display: flex;\n  gap: 16px;\n  padding: 16px;\n  background: #F5F5F5;\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border: 1px solid var(--glass-border);\n  border-radius: 24px;\n  transition: all 0.3s ease;\n  position: relative;\n  overflow: hidden;\n}\n.activity-card::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(circle at var(--x, 50%) var(--y, 50%), rgba(86, 168, 112, 0.1), transparent 70%);\n  opacity: 0;\n  transition: opacity 0.3s;\n  pointer-events: none;\n}\n.activity-card:hover {\n  transform: translateX(4px);\n  border-color: var(--primary);\n}\n.activity-card:hover::after {\n  opacity: 1;\n}\n.activity-icon {\n  position: relative;\n  width: 56px;\n  height: 56px;\n  border-radius: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  overflow: hidden;\n}\n.activity-icon.relatorio {\n  background: linear-gradient(135deg, rgba(86, 168, 112, 0.2), rgba(86, 168, 112, 0.1));\n  color: var(--primary);\n}\n.activity-icon span {\n  font-size: 28px;\n  position: relative;\n  z-index: 2;\n}\n.icon-pulse {\n  position: absolute;\n  inset: -4px;\n  background: radial-gradient(circle at center, currentColor, transparent 70%);\n  opacity: 0;\n  transition: opacity 0.3s;\n  filter: blur(8px);\n}\n.activity-card:hover .icon-pulse {\n  opacity: 0.3;\n}\n.activity-content {\n  flex: 1;\n}\n.activity-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 8px;\n}\n.activity-time {\n  font-size: 0.7rem;\n  color: var(--text-muted);\n  background: var(--glass-bg);\n  padding: 4px 10px;\n  border-radius: 30px;\n  border: 1px solid var(--glass-border);\n}\n.activity-description {\n  font-size: 0.85rem;\n  color: var(--text-secondary);\n  margin-bottom: 12px;\n  line-height: 1.5;\n}\n.activity-metrics {\n  display: flex;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n.metric {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  padding: 4px 12px;\n  background: var(--glass-bg);\n  border: 1px solid var(--glass-border);\n  border-radius: 30px;\n  font-size: 0.7rem;\n  color: var(--text-secondary);\n}\n.metric span:first-child {\n  font-size: 16px;\n  color: var(--primary);\n}\n.metric.warning {\n  color: var(--warning);\n}\n.metric.warning span:first-child {\n  color: var(--warning);\n}\n/* ===== DIAGNOSIS GRID (para listagens) ===== */\n.diagnoses-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 16px;\n  margin-top: 16px;\n}\n.diagnosis-card {\n  position: relative;\n  display: flex;\n  gap: 12px;\n  padding: 12px;\n  background: #f7f5f0;\n  border: 1px solid var(--glass-border);\n  border-radius: 20px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n.diagnosis-card:hover {\n  transform: translateY(-2px);\n  border-color: var(--primary);\n}\n.diagnosis-image {\n  width: 80px;\n  height: 80px;\n  object-fit: cover;\n  border-radius: 12px;\n}\n.diagnosis-info {\n  flex: 1;\n}\n.diagnosis-info h4 {\n  font-size: 14px;\n  font-weight: 600;\n  margin-bottom: 2px;\n  color: var(--text-primary);\n}\n.plant-type {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n}\n.confidence-bar {\n  width: 100%;\n  height: 4px;\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 2px;\n  margin-bottom: 4px;\n  overflow: hidden;\n}\n.confidence-fill {\n  height: 100%;\n  background: linear-gradient(90deg, var(--primary), var(--secondary));\n  border-radius: 2px;\n}\n.confidence {\n  font-size: 10px;\n  color: var(--primary);\n  font-weight: 600;\n}\n.date {\n  font-size: 9px;\n  color: var(--text-muted);\n  margin-top: 4px;\n}\n.severity-badge {\n  position: absolute;\n  top: 12px;\n  right: 12px;\n  padding: 2px 8px;\n  border-radius: 12px;\n  font-size: 9px;\n  font-weight: 600;\n}\n.severity-badge.baixa {\n  background: rgba(86, 168, 112, 0.2);\n  color: var(--primary);\n  border: 1px solid var(--primary);\n}\n.severity-badge.moderada {\n  background: rgba(255, 170, 0, 0.2);\n  color: #ffaa00;\n  border: 1px solid #ffaa00;\n}\n.severity-badge.alta {\n  background: rgba(255, 68, 68, 0.2);\n  color: #ff4444;\n  border: 1px solid #ff4444;\n}\n.delete-btn {\n  position: absolute;\n  bottom: 12px;\n  right: 12px;\n  width: 28px;\n  height: 28px;\n  border-radius: 8px;\n  background: rgba(255, 68, 68, 0.1);\n  border: 1px solid rgba(255, 68, 68, 0.2);\n  color: #ff4444;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  opacity: 0;\n  transition: all 0.3s ease;\n}\n.diagnosis-card:hover .delete-btn {\n  opacity: 1;\n}\n.delete-btn:hover {\n  background: rgba(255, 68, 68, 0.2);\n  transform: scale(1.1);\n}\n.delete-btn span {\n  font-size: 16px;\n}\n/* ===== MODAL ===== */\n.modal-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.8);\n  backdrop-filter: blur(10px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n.modal-content {\n  position: relative;\n  max-width: 500px;\n  width: 90%;\n  max-height: 80vh;\n  overflow-y: auto;\n  background: linear-gradient(135deg, var(--background-darker), var(--background-dark));\n  border: 1px solid var(--glass-border);\n  border-radius: 30px;\n  padding: 24px;\n}\n.modal-content img {\n  width: 100%;\n  height: 200px;\n  object-fit: cover;\n  border-radius: 20px;\n  margin-bottom: 20px;\n}\n.modal-content h2 {\n  font-size: 24px;\n  margin-bottom: 16px;\n  color: var(--primary);\n}\n.modal-details {\n  margin-top: 16px;\n}\n.modal-details p {\n  margin-bottom: 8px;\n  color: var(--text-secondary);\n}\n.modal-details h4 {\n  margin: 16px 0 8px;\n  color: var(--text-primary);\n}\n.close-btn {\n  position: absolute;\n  top: 16px;\n  right: 16px;\n  width: 40px;\n  height: 40px;\n  border-radius: 12px;\n  background: var(--glass-bg);\n  border: 1px solid var(--glass-border);\n  color: var(--text-primary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n.close-btn:hover {\n  border-color: var(--primary);\n  color: var(--primary);\n}\n.close-btn span {\n  font-size: 20px;\n}\n/* ===== MAPA TAB ===== */\n.mapa-container {\n  max-width: 600px;\n  margin: 0 auto;\n}\n.empty-icon {\n  position: relative;\n  width: 100px;\n  height: 100px;\n  margin: 0 auto 30px;\n  background: linear-gradient(135deg, var(--primary-soft), rgba(0, 102, 255, 0.1));\n  border: 2px solid var(--glass-border);\n  border-radius: 50px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.empty-icon span {\n  font-size: 50px;\n  color: var(--primary);\n  position: relative;\n  z-index: 2;\n}\n.empty-icon-ring {\n  position: absolute;\n  inset: -10px;\n  border: 2px solid var(--primary);\n  border-radius: 60px;\n  animation: spin 10s linear infinite;\n  opacity: 0.3;\n}\n.empty-action-btn {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  gap: 12px;\n  padding: 16px 32px;\n  background: linear-gradient(135deg, var(--primary), var(--secondary));\n  border: none;\n  border-radius: 40px;\n  color: #000;\n  font-weight: 600;\n  font-size: 1rem;\n  cursor: pointer;\n  overflow: hidden;\n  transition: all 0.3s ease;\n}\n.empty-action-btn span {\n  position: relative;\n  z-index: 2;\n}\n.empty-action-btn .btn-glow {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 150%;\n  height: 150%;\n  background: radial-gradient(circle, rgba(255, 255, 255, 0.8) 0%, transparent 70%);\n  transform: translate(-50%, -50%) scale(0);\n  transition: transform 0.5s ease;\n  pointer-events: none;\n}\n.empty-action-btn:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 10px 30px var(--primary-glow);\n}\n.empty-action-btn:hover .btn-glow {\n  transform: translate(-50%, -50%) scale(1);\n}\n.empty-action-btn span:last-child {\n  font-size: 20px;\n}\n/* ===== SCROLLBARS ===== */\n::-webkit-scrollbar {\n  width: 8px;\n}\n::-webkit-scrollbar-track {\n  background: var(--background-darker);\n}\n::-webkit-scrollbar-thumb {\n  background: linear-gradient(135deg, var(--primary), var(--secondary));\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: linear-gradient(135deg, var(--primary-dark), #0055cc);\n}\n.database-grid::-webkit-scrollbar {\n  width: 4px;\n}\n.database-grid::-webkit-scrollbar-track {\n  background: var(--glass-bg);\n}\n.database-grid::-webkit-scrollbar-thumb {\n  background: var(--primary);\n  border-radius: 4px;\n}\n/* ===== ANIMAÇÕES ===== */\n@keyframes livePulse {\n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.5; transform: scale(1.3); }\n}\n@keyframes scan {\n  0% { transform: translateX(-100%); }\n  100% { transform: translateX(100%); }\n}\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n@keyframes pulse {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.05); }\n}\n/* ===== RESPONSIVE ===== */\n@media (max-width: 480px) {\n  .options-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .result-actions {\n    grid-template-columns: 1fr;\n  }\n  \n  .disease-name {\n    font-size: 1.5rem;\n  }\n  \n  .result-content {\n    padding: 20px;\n  }\n  \n  .option-card {\n    padding: 24px 16px;\n  }\n  \n  .option-icon {\n    width: 60px;\n    height: 60px;\n  }\n  \n  .option-icon span {\n    font-size: 30px;\n  }\n  \n  .option-card h3 {\n    font-size: 1.2rem;\n  }\n  \n  .history-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  \n  .empty-state {\n    padding: 40px 20px;\n  }\n  \n  .empty-icon {\n    width: 80px;\n    height: 80px;\n  }\n  \n  .empty-icon span {\n    font-size: 40px;\n  }\n  \n  .empty-state h3 {\n    font-size: 1.2rem;\n  }\n  \n  .database-grid {\n    grid-template-columns: 1fr;\n  }\n}\n/* EXPLORE TABS */\n/* ===== EXPLORE TABS - APENAS BOTÕES MODERNOS ===== */\n.explore-tabs-header {\n  position: relative;\n  z-index: 10;\n  padding: calc(env(safe-area-inset-top, 0px) + 16px) 0 32px;\n  background:\n  